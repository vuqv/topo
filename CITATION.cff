# Citation File Format — https://citation-file-format.github.io/
# GitHub reads this to render a "Cite this repository" button.
#
# Uncomment `preferred-citation` once a paper/preprint exists. Keep this file in
# sync with docs/citation.rst.
cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "TOPO: a topology-based coarse-grained model for folded proteins"
abstract: >-
  TOPO is a Python library and command-line toolkit for coarse-grained
  molecular dynamics of globular (folded) proteins, built on OpenMM. It builds a
  one-bead-per-residue structure-based (Go-like) model from a single folded
  structure and can also run per-codon co-translational synthesis.
type: software
authors:
  - family-names: Vu
    given-names: Quyen
    orcid: "https://orcid.org/0000-0002-9863-0486"
version: "2026.1"
date-released: "2026-07-12"
license: "GPL-3.0-or-later"
# Concept DOI (Zenodo) — always resolves to the latest version.
doi: "10.5281/zenodo.21360706"
identifiers:
  - type: doi
    value: "10.5281/zenodo.21360706"
    description: "Concept DOI — all versions"
  - type: doi
    value: "10.5281/zenodo.21360707"
    description: "Version DOI — 2026.1"
url: "https://github.com/vuqv/topo"
repository-code: "https://github.com/vuqv/topo"
keywords:
  - coarse-grained
  - molecular-dynamics
  - structure-based-model
  - Go-model
  - protein-folding
  - co-translational-folding
  - OpenMM
